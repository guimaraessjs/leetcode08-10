
class Solution {
    public String removeOuterParentheses(String s) {
        StringBuilder resultado = new StringBuilder();
        int nivel = 0;

        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);

            if (c == '(') {
                if (nivel > 0) {
                    resultado.append(c);
                }
                nivel++;
            } else {
                nivel--;

                if (nivel > 0) {
                    resultado.append(c);
                }
            }
        }

        return resultado.toString();
    }
}
